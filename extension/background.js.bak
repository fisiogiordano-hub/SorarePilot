importScripts('bridge-types.js');function noop(){}let queueState={mode:'idle',flow:null,currentItem:null,remainingCount:0,completedCount:0,totalCount:0,items:[],lastMessage:'Pronto'};let timerId=null;function syncState(msg){if(msg)queueState.lastMessage=msg;queueState.remainingCount=queueState.items.length;chrome.storage.local.set({sorareQueueState:queueState});chrome.runtime.sendMessage({type:'QUEUE_STATE_UPDATED',state:queueState}).catch(noop);}
function sleep(ms){return new Promise(function(resolve){timerId=setTimeout(resolve,ms);});}async function processNext(){if(queueState.mode!=='running')return;if(queueState.items.length===0){queueState.mode='completed';queueState.currentItem=null;syncState('Coda completata');return;}const next=queueState.items.shift();queueState.currentItem=next;const name=next.label?next.label:(next.id?next.id:'elemento');syncState('In corso: '+name);await sleep(randomHumanDelay(queueState.flow));if(queueState.mode==='stopped'){queueState.items.unshift(next);queueState.currentItem=null;syncState('Esecuzione fermata');return;}while(queueState.mode==='paused'){syncState('In pausa su: '+name);await sleep(600);}if(queueState.mode!=='running')return;queueState.completedCount+=1;queueState.currentItem=null;syncState('Completato ('+queueState.completedCount+'/'+queueState.totalCount+')');processNext();}
chrome.runtime.onMessage.addListener(function(msg,sender,sendResponse){if(!msg)return;if(msg.type==='GET_QUEUE_STATE'){sendResponse({state:queueState});return true;}if(msg.type==='START_FLOW'){clearTimeout(timerId);const items=Array.isArray(msg.items)?msg.items.slice():[];const flow=msg.flow?msg.flow:'lineups';queueState={mode:'running',flow:flow,currentItem:null,remainingCount:items.length,completedCount:0,totalCount:items.length,items:items,lastMessage:'Avviato '+flow};syncState();if(flow==='missions'){const count=queueState.items.length;queueState.items=[];queueState.completedCount=count;queueState.mode='completed';syncState('Missioni inviate ('+count+')');}else{processNext();}sendResponse({ok:true,state:queueState});return true;}if(msg.type==='PAUSE_QUEUE'){if(queueState.mode==='running'){queueState.mode='paused';syncState('Coda in pausa');}sendResponse({ok:true,state:queueState});return true;}if(msg.type==='RESUME_QUEUE'){if(queueState.mode==='paused'){queueState.mode='running';syncState('Coda ripresa');processNext();}sendResponse({ok:true,state:queueState});return true;}if(msg.type==='STOP_QUEUE'){clearTimeout(timerId);queueState.mode='stopped';queueState.currentItem=null;syncState('Coda interrotta');sendResponse({ok:true,state:queueState});return true;}});
chrome.runtime.onMessage.addListener(function(msg,sender,sendResponse){if(!msg)return;if(msg.type==='GET_QUEUE_STATE'){sendResponse({state:queueState});return true;}if(msg.type==='START_FLOW'){clearTimeout(timerId);const items=Array.isArray(msg.items)?msg.items.slice():[];const flow=msg.flow?msg.flow:'lineups';queueState={mode:'running',flow:flow,currentItem:null,remainingCount:items.length,completedCount:0,totalCount:items.length,items:items,lastMessage:'Avviato '+flow};syncState();if(flow==='missions'){const count=queueState.items.length;queueState.items=[];queueState.completedCount=count;queueState.mode='completed';syncState('Missioni inviate ('+count+')');}else{processNext();}sendResponse({ok:true,state:queueState});return true;}if(msg.type==='PAUSE_QUEUE'){if(queueState.mode==='running'){queueState.mode='paused';syncState('Coda in pausa');}sendResponse({ok:true,state:queueState});return true;}if(msg.type==='RESUME_QUEUE'){if(queueState.mode==='paused'){queueState.mode='running';syncState('Coda ripresa');processNext();}sendResponse({ok:true,state:queueState});return true;}if(msg.type==='STOP_QUEUE'){clearTimeout(timerId);queueState.mode='stopped';queueState.currentItem=null;syncState('Coda interrotta');sendResponse({ok:true,state:queueState});return true;}});
