{
  "manifest_version": 3,
  "name": "SorarePilot Companion",
  "version": "0.1.0",
  "description": "Companion MV3 per missioni giornaliere, formazioni e vendite Sorare.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.sorare.com/*",
    "https://sorarepilot.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://sorarepilot.onrender.com/*"
      ],
      "js": [
        "bridge-types.js",
        "content-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.sorare.com/*"
      ],
      "js": [
        "bridge-types.js",
        "sorare-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SorarePilot Companion",
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sorarepilot-companion@local.dev",
      "strict_min_version": "112.0"
    }
  },
  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  }
}
